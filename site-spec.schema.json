{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "3is Web Studio Site Specification",
  "description": "Schema for site-spec.json — a neutral static-site template used by 3is Web Studio for future tenant/client projects.",
  "type": "object",
  "required": [
    "schema_version",
    "tenant_id",
    "interface_id",
    "interface_type",
    "template_id",
    "site",
    "nav",
    "sections",
    "release"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Version of this specification format.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "tenant_id": {
      "type": "string",
      "description": "Unique identifier for the tenant or client. Must not contain real names or credentials in the template."
    },
    "interface_id": {
      "type": "string",
      "description": "Unique identifier for this interface instance."
    },
    "interface_type": {
      "type": "string",
      "description": "Type of interface.",
      "enum": ["static-site", "landing-page", "microsite"]
    },
    "template_id": {
      "type": "string",
      "description": "Identifier linking this spec to the base template version."
    },
    "site": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string", "minLength": 1 }
      }
    },
    "nav": {
      "type": "array",
      "description": "Array of navigation items with label and local href only.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "href"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "href": { "type": "string", "pattern": "^#" }
        }
      }
    },
    "sections": {
      "type": "object",
      "required": ["hero", "about", "themes", "placemake", "featured", "cta", "footer"],
      "properties": {
        "hero": {
          "type": "object",
          "required": ["heading", "description", "ctaText"],
          "properties": {
            "eyebrow": { "type": "string", "minLength": 1 },
            "heading": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "ctaText": { "type": "string", "minLength": 1 }
          }
        },
        "about": {
          "type": "object",
          "required": ["heading", "content"],
          "properties": {
            "heading": { "type": "string", "minLength": 1 },
            "content": { "type": "string", "minLength": 1 }
          }
        },
        "themes": {
          "type": "object",
          "required": ["heading", "items"],
          "properties": {
            "heading": { "type": "string", "minLength": 1 },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["title", "description"],
                "properties": {
                  "icon": { "type": "string" },
                  "title": { "type": "string", "minLength": 1 },
                  "description": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "placemake": {
          "type": "object",
          "required": ["heading", "content"],
          "properties": {
            "heading": { "type": "string", "minLength": 1 },
            "content": { "type": "string", "minLength": 1 }
          }
        },
        "featured": {
          "type": "object",
          "required": ["heading", "items"],
          "properties": {
            "heading": { "type": "string", "minLength": 1 },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["title", "description"],
                "properties": {
                  "title": { "type": "string", "minLength": 1 },
                  "description": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "cta": {
          "type": "object",
          "required": ["heading", "description", "buttonText"],
          "properties": {
            "heading": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "buttonText": { "type": "string", "minLength": 1 }
          }
        },
        "footer": {
          "type": "object",
          "required": ["organisationName"],
          "properties": {
            "organisationName": { "type": "string", "minLength": 1 },
            "email": { "type": ["string", "null"] },
            "year": { "type": "integer", "minimum": 2000 }
          }
        }
      }
    },
    "release": {
      "type": "object",
      "required": ["version", "created", "owner"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?$"
        },
        "status": { "type": "string", "enum": ["draft", "review", "approved", "released"] },
        "environment": { "type": "string" },
        "created": { "type": "string", "format": "date" },
        "owner": { "type": "string", "minLength": 1 },
        "approved_by": { "type": "string", "minLength": 1 },
        "template": { "type": "string" }
      }
    },
    "localPreview": {
      "type": "object",
      "properties": {
        "note": { "type": "string" }
      }
    }
  }
}
